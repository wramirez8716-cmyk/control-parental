<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos necesarios para el monitoreo y servicio en segundo plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:allowBackup="true"
        android:label="Control Parental"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">

        <!-- Pantalla Principal (Selección de rol) -->
        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla del Padre -->
        <activity android:name=".PadreActivity" />

        <!-- Pantalla del Hijo -->
        <activity android:name=".HijoActivity" />

        <!-- Servicio de Monitoreo (Configurado para Android 14 / Xiaomi) -->
        <service 
            android:name=".ServicioMonitoreo" 
            android:foregroundServiceType="specialUse" />

        <!-- Receptor para bloquear la pantalla (Administrador de dispositivo) -->
        <receiver
            android:name=".MyDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>