<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel del Padre"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="20dp" />

        <!-- Caja del Código de Familia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E3F2FD"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginBottom="15dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu Código de Familia:"
                android:textSize="16sp"
                android:textColor="#555" />

            <TextView
                android:id="@+id/tv_codigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="------"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_margin="10dp" />

            <Button
                android:id="@+id/btn_generar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generar Código"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Caja de App Activa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="15dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 App activa: "
                android:textSize="16sp"
                android:textColor="#333" />

            <TextView
                android:id="@+id/tv_app_activa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En espera..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_marginLeft="10dp" />
        </LinearLayout>

        <!-- Caja de Historial -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="15dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tv_historial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Historial:\n(Esperando datos...)"
                android:textSize="14sp"
                android:textColor="#555" />
        </LinearLayout>

        <!-- NUEVA SECCIÓN: Apps Pendientes de Aprobación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF3E0"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="15dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Apps instaladas recientemente:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tv_pendiente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ninguna app pendiente."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="15dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_aprobar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✅ Aprobar"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="5dp" />

                <Button
                    android:id="@+id/btn_bloquear_app"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚫 Bloquear"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:layout_marginLeft="5dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón de Bloqueo de Tablet -->
        <Button
            android:id="@+id/btn_bloquear"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🔒 BLOQUEAR TABLET AHORA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <!-- Botón de Cerrar Sesión -->
        <Button
            android:id="@+id/btn_salir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar Sesión"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>